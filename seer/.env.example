# The Seer's environment. Copy to seer/.env (gitignored) and fill in. Nothing here is read by the module.
# docs/seer-contract.md documents every variable.

# The key, made for the Seer and nothing else, with a spend limit set in the Console. Unset = stub mode.
ANTHROPIC_API_KEY=
# 1 forces the stub model even with a key (tests, a live check without spending).
MODEL_STUB=0

# The Foundry the Seer joins and probes. On the box: Foundry's own port on localhost.
FOUNDRY_URL=http://localhost:30000
# The ball's user (role Player) and its password, created by the GM in User Management.
BALL_USER=Crystal Ball
BALL_PASSWORD=

# Where the Seer listens. 127.0.0.1 only; a tunnel or reverse proxy routes BASE_PATH here.
PORT=30001
BIND=127.0.0.1
BASE_PATH=/crystalball
# The one origin allowed to call cross-origin (the sandbox, where Foundry and the Seer sit on different
# ports). Leave unset on prod, where the tunnel makes them one origin.
CORS_ORIGIN=http://localhost:30000

# Storage and config.
DATA_DIR=seer/data
CONFIG=seer/config.json
LOG_LEVEL=info
